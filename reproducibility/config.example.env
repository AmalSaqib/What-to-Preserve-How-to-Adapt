#!/usr/bin/env bash
# Copy this file to `.env`, adjust the paths, and source it before running:
#   source reproducibility/config.example.env
#
# The defaults keep all generated data under <repository>/data. For an
# existing nnU-Net installation, set PAPER_DATA_ROOT before sourcing.

export PAPER_REPO_ROOT="${PAPER_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PAPER_DATA_ROOT="${PAPER_DATA_ROOT:-${PAPER_REPO_ROOT}/data}"
export nnUNet_raw_data_base="${nnUNet_raw_data_base:-${PAPER_DATA_ROOT}/nnUNet_raw_base}"
export nnUNet_preprocessed="${nnUNet_preprocessed:-${PAPER_DATA_ROOT}/nnUNet_preprocessed}"
export RESULTS_FOLDER="${RESULTS_FOLDER:-${PAPER_DATA_ROOT}/results}"
export EVALUATION_FOLDER="${EVALUATION_FOLDER:-${PAPER_DATA_ROOT}/evaluation}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/what-to-preserve-matplotlib}"

# The fold-0 UMD checkpoint used to initialize every controlled two-task run.
export PAPER_INIT_CHECKPOINT="${PAPER_INIT_CHECKPOINT:-${RESULTS_FOLDER}/nnUNet_ext/3d_fullres/Task666_UMD_Task555_ECPC_Task778_EndoMRI_T1FS/Task666_UMD/nnUNetTrainerSequential__nnUNetPlansv2.1/Generic_UNet/SEQ/fold_0}"
